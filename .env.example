APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo por la API de Resend: Railway bloquea el SMTP saliente.
# Para desarrollo local sin clave de Resend puedes usar MAIL_MAILER=log
# (los correos se escriben en storage/logs/laravel.log).
MAIL_MAILER=resend
RESEND_API_KEY=
# Sin dominio verificado en Resend solo se puede usar este remitente,
# y solo entrega al correo del dueño de la cuenta (ver CLAUDE.md).
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"
# El proyecto no usa webhooks de Resend: la ruta /resend/webhook queda apagada
RESEND_ROUTES=false

# Solo si algún día se vuelve a SMTP (no funciona en Railway)
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_TIMEOUT=5

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Datos del consultorio para la impresión del expediente (provisionales)
CONSULTORIO_NOMBRE="Melissa López N."
CONSULTORIO_SUBTITULO="Cirujano Dentista"
CONSULTORIO_CEDULA=
CONSULTORIO_DIRECCION="Lázaro Cárdenas, Michoacán"
CONSULTORIO_TELEFONO=
CONSULTORIO_CORREO=

# Avisos a la clinica por Telegram (vacio = desactivado)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Imagenes subidas desde el panel. En Railway: Volume montado en /data y IMAGENES_ROOT=/data/imagenes
IMAGENES_DISK=imagenes
IMAGENES_ROOT=
IMAGENES_URL=
IMAGENES_REDIMENSIONAR=true
